# ── Telegram Bot (bot.js) ─────────────────────────────────────────────────
# Token from @BotFather — only needed if running the separate bot.js
BOT_TOKEN=your_telegram_bot_token_here

# ── Telethon Userbot (userbot.py) ─────────────────────────────────────────
# Get these from https://my.telegram.org/apps (log in → API development tools)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
# Session file name (stored locally, keeps you logged in between restarts)
SESSION_NAME=carousell_user

# Google Forms – Game listing submissions
GAME_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSe-0uL1GuyqAR0O5HbXIDoYFlVhGAkQa0zqTHcaYK4d_n7QwQ/formResponse
GAME_FIELD_TITLE=entry.2072004085
GAME_FIELD_NORMAL=entry.710378137
GAME_FIELD_PREMIUM=entry.1907115641
GAME_FIELD_PLATFORM=entry.1583771425
GAME_FIELD_URL=entry.1870493243

# Google Forms – Digital Code submissions
CODE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSfTj5GdwtAvIQtEPYofMpKnZm3EtBJ3k0a5IT54gQN0tOS44Q/formResponse
